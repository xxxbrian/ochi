{
  "typography": {
    "family": "Geist",
    "codeFamily": "SFMono-Regular",
    "size": { "base": 15, "ui": 14, "meta": 13, "caption": 12, "body": 16 },
    "weight": { "normal": 400, "medium": 500, "heading": 550, "emphasis": 600 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32 },
  "radius": { "field": 8, "item": 10, "panel": 12, "dialog": 16, "composer": 24 },
  "control": { "compact": 32, "normal": 36, "touch": 44 },
  "motion": { "duration": 160, "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
  "theme": {
    "light": {
      "canvas": "#f9f8f7",
      "sidebar": "#f5f3f2",
      "raised": "#ffffff",
      "field": "#ffffff",
      "ink": "#171615",
      "muted": "#6d6b68",
      "subtle": "#8d8984",
      "hover": "#eeecea",
      "line": "#e6e5e3",
      "line-strong": "#d4d2cf",
      "danger": "#c13d35",
      "success": "#2d7652"
    },
    "dark": {
      "canvas": "#131211",
      "sidebar": "#181716",
      "raised": "#222120",
      "field": "#222120",
      "ink": "#fcfcfc",
      "muted": "#aaa7a2",
      "subtle": "#84807a",
      "hover": "#2c2b29",
      "line": "#343230",
      "line-strong": "#484542",
      "danger": "#ef8b83",
      "success": "#83c9a6"
    }
  },
  "webShadow": {
    "light": {
      "popover": "0 8px 28px rgb(23 22 21 / 10%), 0 2px 6px rgb(23 22 21 / 4%)",
      "dialog": "0 20px 64px rgb(23 22 21 / 16%)"
    },
    "dark": {
      "popover": "0 8px 28px rgb(0 0 0 / 28%), 0 2px 6px rgb(0 0 0 / 16%)",
      "dialog": "0 20px 64px rgb(0 0 0 / 40%)"
    }
  }
}
