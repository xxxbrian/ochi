# Administrator configuration. Copy to .env; do not commit credentials.
POSTGRES_PASSWORD=
OCHI_USERS='[{"username":"admin","display_name":"Admin","password":"","role":"admin"}]'
SECURE_COOKIES=false

# Published installations: copy the exact image refs from a CI images.json.
# Empty values keep the local source-build images used by the root README.
OCHI_SERVER_IMAGE=
OCHI_POSTGRES_IMAGE=
OCHI_WORKSPACE_IMAGE=

# OpenAI-compatible chat-completions endpoint; the URL includes /v1 if required.
RUNNER=openai
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
WORKSPACE_ENABLED=true

# Optional HTTPS manifest override for a separately maintained update channel.
# Release builds use the project's rolling channel by default.
OCHI_UPDATE_URL=

# RUNNER=demo is an explicit development mode, not a fallback for missing keys.
