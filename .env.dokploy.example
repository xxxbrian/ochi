# Paste into the Dokploy Compose environment, not GitHub Actions.
# Use a URL-safe random password (hex is convenient for DATABASE_URL).
POSTGRES_PASSWORD=
OCHI_USERS='[{"username":"admin","display_name":"Admin","password":"","role":"admin"}]'

# Optional provider bootstrap. Later administrator edits take precedence.
RUNNER=openai
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
WORKSPACE_ENABLED=true

# Physical names must stay stable across updates. Set explicitly when adopting
# existing volumes/networks; changing these names does not move existing data.
OCHI_DATABASE_VOLUME=ochi-database
OCHI_ARTIFACTS_VOLUME=ochi-artifacts
OCHI_NETWORK_NAME=ochi
OCHI_COMPUTE_NETWORK_NAME=ochi-compute
